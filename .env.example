# Copy to .env.local for local development, or set these in your
# Vercel / Netlify project settings. Every variable is optional.
# NEXT_PUBLIC_* values are embedded in the browser bundle — never put a secret here.

# Public site URL used for canonical and Open Graph links (custom domain).
# Vercel and Netlify builds detect their own address automatically.
# NEXT_PUBLIC_SITE_URL=https://faisal-weds-sadaf.example

# RSVP backend. Leave unset to use the in-browser demo adapter (localStorage).
# When set, replies are POSTed as JSON to this URL instead — see README › RSVP.
# NEXT_PUBLIC_RSVP_ENDPOINT=https://your-backend.example/api/rsvp
